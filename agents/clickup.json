{
  "name": "clickup",
  "description": "ClickUp ticket automation harness (personal-harness repo).",
  "project_env_var": "CLICKUP_PROJECT_REPO",
  "project_sibling": "p-harness",
  "setup": [
    ["sh", "-c", "test -d .venv || python3 -m venv .venv"],
    [".venv/bin/pip", "install", "-e", ".[dev]"]
  ],
  "env_example": ".env.example",
  "env_file": ".env",
  "flow": [
    [".venv/bin/harness", "clickup", "get-task", "--task-id", "{subject_id}"]
  ]
}
