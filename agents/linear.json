{
  "name": "linear",
  "description": "Linear issue automation harness (personal-harness repo).",
  "project_env_var": "LINEAR_PROJECT_REPO",
  "project_sibling": "p-harness",
  "setup": [
    ["sh", "-c", "test -d .venv || python3 -m venv .venv"],
    [".venv/bin/pip", "install", "-e", ".[dev]"]
  ],
  "env_example": ".env.example",
  "env_file": ".env",
  "flow": [
    [".venv/bin/harness", "linear", "get-issue", "--issue-id", "{subject_id}"]
  ]
}
