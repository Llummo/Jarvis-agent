# ClickUp — a personal API token from Settings -> Apps.
CLICKUP_API_TOKEN=pk_xxx_xxx
# Optional defaults, so --team-id / --list-id can be omitted.
CLICKUP_TEAM_ID=
CLICKUP_LIST_ID=

# Linear — a personal API key from Settings -> Security & access.
LINEAR_API_KEY=lin_api_xxx

# Gemini — an API key from aistudio.google.com, used for repository embeddings.
GEMINI_API_KEY=
